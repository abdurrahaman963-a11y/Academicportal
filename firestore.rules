rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function hasUserProfile() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        (request.auth.token.keys().hasAll(['email']) && request.auth.token.email == 'admin@schoolhub.com') ||
        (hasUserProfile() && getUserData().role == 'SUPER_ADMIN')
      );
    }

    function isSchoolAdmin(schoolId) {
      return isSignedIn() && (
        isSuperAdmin() || 
        (hasUserProfile() && getUserData().role == 'SCHOOL_ADMIN' && getUserData().schoolId == schoolId)
      );
    }

    function isSchoolMember(schoolId) {
      return isSignedIn() && (
        isSuperAdmin() || 
        (hasUserProfile() && getUserData().schoolId == schoolId)
      );
    }

    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // User Profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // SaaS Schools Collection & Isolated Subcollections
    match /schools/{schoolId} {
      allow read, write: if true;

      // Isolated Subcollections under /schools/{schoolId}/...
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // Usage Statistics Log Collection
    match /usage_stats/{dateKey} {
      allow read, write: if true;
    }

    // Meta System Collection
    match /meta/{docId} {
      allow read, write: if true;
    }
  }
}
